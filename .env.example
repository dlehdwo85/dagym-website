# ─── 사이트 ───────────────────────────────────────────────────────
# 대표 도메인 (canonical / sitemap / Open Graph). 미설정 시 https://www.dagym-in.co.kr
NEXT_PUBLIC_SITE_URL=

# ─── 운영 문의 → 공용 CRM (HILINK 와 같은 Supabase 프로젝트) ─────
# docs/CONTACT_SETUP.md 참고. 실제 값은 Vercel 환경변수에만 넣는다 (Git · 문서 · 로그 금지).
NEXT_PUBLIC_SUPABASE_URL=
# 서버 전용 — NEXT_PUBLIC_ 접두사 절대 금지
SUPABASE_SERVICE_ROLE_KEY=

# 알림 메일 수신 (미설정 시 기본 수신 주소) + 선택 보조 수신
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_EMAIL_SECONDARY=
# 알림 채널 — 하나 이상 (복수 설정 시 모두 발송)
# 1) SMTP (Gmail · 네이버 등, 앱 비밀번호 사용)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 2) Resend
RESEND_API_KEY=
LEAD_FROM_EMAIL=
# 3) Webhook (JSON POST: { subject, text })
LEAD_NOTIFY_WEBHOOK_URL=

# 알림 메일의 "관리자에서 문의 확인" 링크 기준 (HILINK 관리자 도메인). 서버 전용
CRM_ADMIN_BASE_URL=

# ─── 전환 · 광고 측정 (선택) ─────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ─── 구 문의 경로 (전환 기간 호환 — 신규 파이프라인 검증 후 제거 예정) ──
# 설정되어 있으면 새 문의 알림의 보조 채널로도 사용된다.
CONTACT_WEBHOOK_URL=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# 1 로 설정하면 사진이 들어갈 자리를 점선 박스로 표시 (검수용 · Production 금지)
NEXT_PUBLIC_SHOW_PHOTO_SLOTS=
